# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/platetrack?retryWrites=true&w=majority

# Server
PORT=5000

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gmail SMTP (use a 16-character Gmail "App Password", not your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=yourofficialaccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Used in outgoing email templates
APP_NAME=PlateTrack

# URL of the Python ML microservice (YOLOv8 + PaddleOCR) that handles
# license plate detection. This comes from the PlateTrack_ANPR_Pipeline
# Colab notebook (Part 3) — it's a temporary cloudflared URL that changes
# every time the Colab session restarts, so update this whenever that
# happens. Leave blank to disable AI detection (enforcers can still use
# manual entry on the violation form).
ML_SERVICE_URL=
